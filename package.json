{
  "name": "startify",
  "displayName": "Startify",
  "version": "1.5.5",
  "private": true,
  "description": "A customizable and beautiful new tab page for your browser.",
  "author": "PawelGawlikDev",
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode testing",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "e2e": "playwright test",
    "e2e:debug": "cross-env DEBUG=true playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "fix": "bun run fix:eslint && bun run fix:prietter",
    "fix:eslint": "eslint . --fix",
    "fix:prietter": "prettier . --write --config .prettierrc.mjs",
    "postinstall": "wxt prepare",
    "lint": "bun run lint:eslint && bun run lint:prietter",
    "lint:eslint": "eslint .",
    "lint:prietter": "prettier . --check --config .prettierrc.mjs",
    "prepare": "husky",
    "release": "standard-version",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dexie": "^4.4.7",
    "dexie-react-hooks": "^4.4.0",
    "lucide-react": "^1.70.0",
    "motion": "^14.10.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-dropzone": "^20.1.4",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "@vitest/ui": "^5.1.0",
    "@wxt-dev/auto-icons": "^1.1.2",
    "@wxt-dev/module-react": "^1.2.2",
    "commitlint": "^21.2.4",
    "cross-env": "^10.1.0",
    "eslint": "^10.14.0",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unicorn": "^79.0.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.0",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "standard-version": "^9.5.0",
    "svgo": "^4.1.0",
    "tailwind-merge": "^3.7.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^5.1.0",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  }
}
