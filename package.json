{
  "name": "startify",
  "displayName": "Startify",
  "version": "1.5.2",
  "private": true,
  "description": "A customizable and beautiful new tab page for your browser.",
  "author": "PawelGawlikDev",
  "type": "module",
  "scripts": {
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "build:e2e": "wxt build --mode testing",
    "compile": "tsc --noEmit",
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "e2e": "playwright test",
    "e2e:debug": "cross-env DEBUG=true playwright test --debug",
    "e2e:ui": "playwright test --ui",
    "fix": "pnpm '/^fix:.*/'",
    "fix:eslint": "eslint . --fix",
    "fix:prietter": "prettier . --write --config .prettierrc.mjs",
    "postinstall": "wxt prepare",
    "lint": "pnpm '/^lint:.*/'",
    "lint:eslint": "eslint .",
    "lint:prietter": "prettier . --check --config .prettierrc.mjs",
    "prepare": "husky",
    "release": "standard-version",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:ui": "vitest --ui",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox"
  },
  "dependencies": {
    "@radix-ui/react-label": "^2.1.8",
    "@tailwindcss/vite": "^4.2.2",
    "@tanstack/react-query": "^5.94.5",
    "clsx": "^2.1.1",
    "dexie": "^4.3.0",
    "dexie-react-hooks": "^4.2.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-dropzone": "^15.0.0",
    "tailwindcss": "^4.2.2"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^20.5.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/eslint-plugin": "^1.6.12",
    "@vitest/ui": "^4.1.0",
    "@wxt-dev/auto-icons": "^1.1.1",
    "@wxt-dev/module-react": "^1.2.2",
    "commitlint": "^20.5.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.1.0",
    "eslint-plugin-playwright": "^2.10.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-unicorn": "^63.0.0",
    "globals": "^17.4.0",
    "husky": "^9.1.7",
    "jsdom": "^29.0.1",
    "lint-staged": "^16.4.0",
    "prettier": "3.8.1",
    "prettier-plugin-tailwindcss": "^0.7.2",
    "standard-version": "^9.5.0",
    "svgo": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "vitest": "^4.1.0",
    "wxt": "^0.20.20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@tailwindcss/oxide",
      "esbuild",
      "msw",
      "sharp",
      "spawn-sync"
    ]
  }
}
